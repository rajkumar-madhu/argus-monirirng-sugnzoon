[Unit]
Description=WeCrew monitoring OTLP HTTP edge socket

[Socket]
# Loopback only. OTLP has no authenticator/TLS; publishing on 0.0.0.0
# plus an open Hostinger firewall lets anyone poison ClickHouse.
ListenStream=127.0.0.1:4318
Service=wecrew-monitoring-edge@30318.service
NoDelay=true

[Install]
WantedBy=sockets.target

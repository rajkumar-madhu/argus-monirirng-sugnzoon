  "spec": {
    "display": {
      "name": "Nginx customer overview",
      "description": "Grafana-style customer HTTP dashboard from Nginx access logs: KPI tiles (request volume, status codes, bytes, unique visitors, Googlebot), status and bytes time series, method/status mix, top pages/referrers/agents/IPs, and a live request list. Mirrors the Grafana Loki Nginx dashboard layout. Requires attributes.source=nginx from the built-in collector config. Geo map / p95 latency need $request_time + geoip in a custom log_format (not in Nginx combined logs)."
    },
    "variables": [],
    "panels": {
      "5ec414da-e142-50d8-be7c-236fabca36e6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total requests",
            "description": "Access-log lines in the selected window (Grafana Loki KPI)."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "logs",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "source = 'nginx'"
                    },
                    "groupBy": [],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "requests"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },

# Multi-stage build for Hostinger (linux/amd64). Avoids Mac ARM→amd64 sonic/CGO issues.
# Usage: pass all four build metadata arguments from the reviewed Git revision.
# The build intentionally fails when any value is absent.

ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_TIME
ARG BUILD_BRANCH

FROM node:22-bookworm AS frontend
WORKDIR /frontend
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
# pnpm ≥9 requires packages[] when pnpm-workspace.yaml exists
RUN printf '%s\n' "packages:" "  - '.'" | cat - pnpm-workspace.yaml > /tmp/ws.yaml && mv /tmp/ws.yaml pnpm-workspace.yaml
COPY frontend/ ./
RUN CI=1 pnpm install --frozen-lockfile || CI=1 pnpm install
RUN CI=1 pnpm build

FROM golang:1.25.7-bookworm AS backend
ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_TIME
ARG BUILD_BRANCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /frontend/build ./frontend/build
RUN test -n "${BUILD_VERSION}" \
    && test -n "${BUILD_COMMIT}" \
    && test -n "${BUILD_TIME}" \
    && test -n "${BUILD_BRANCH}" \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -C cmd/community -tags timetzdata \
    -ldflags "-s -w \
      -X github.com/your-org/argus/pkg/version.version=${BUILD_VERSION} \
      -X github.com/your-org/argus/pkg/version.hash=${BUILD_COMMIT} \
      -X github.com/your-org/argus/pkg/version.time=${BUILD_TIME} \
      -X github.com/your-org/argus/pkg/version.branch=${BUILD_BRANCH} \
      -X github.com/your-org/argus/pkg/version.variant=community" \
    -o /out/argus-community .

FROM alpine:3.20.3
ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_TIME
LABEL org.opencontainers.image.title="WeCrew Monitoring"
LABEL org.opencontainers.image.source="https://github.com/rajkumar-madhu/argus-monirirng-sugnzoon"
LABEL org.opencontainers.image.version="${BUILD_VERSION}"
LABEL org.opencontainers.image.revision="${BUILD_COMMIT}"
LABEL org.opencontainers.image.created="${BUILD_TIME}"
WORKDIR /root
RUN apk add --no-cache ca-certificates
COPY --from=backend /out/argus-community /root/argus
COPY templates /root/templates
COPY --from=frontend /frontend/build /etc/argus/web/
RUN chmod 755 /root /root/argus
ENTRYPOINT ["./argus", "server"]

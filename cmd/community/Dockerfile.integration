# syntax=docker/dockerfile:1
# Integration-test image for Argus community. Builds the server binary inside Docker
# so pytest can `docker build` without a pre-populated target/ directory.

FROM golang:1.25-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
	go build -C cmd/community -tags timetzdata -ldflags "-s -w" -o /out/argus .

FROM alpine:3.20.3
LABEL org.opencontainers.image.title="Argus (integration)"
LABEL org.opencontainers.image.source="https://github.com/rajkumar-madhu/argus-monirirng-sugnzoon"
WORKDIR /root
RUN apk add --no-cache ca-certificates && rm -rf /var/cache/apk/*
COPY --from=build /out/argus /root/argus
COPY templates /root/templates
ARG WITH_WEB=false
COPY frontend/build/ /etc/argus/web/
RUN chmod 755 /root /root/argus
ENTRYPOINT ["./argus", "server"]
